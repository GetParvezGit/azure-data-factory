			"apiVersion": "2018-06-01",
			"properties": {
				"parameters": {
					"ServiceEndPoint": {
						"type": "string"
					},
					"TenantID": {
						"type": "string"
					},
					"ServicePrincipalID": {
						"type": "string"
					},
					"ServicePrincipalKey": {
						"type": "string"
					}
