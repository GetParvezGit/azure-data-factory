{
	"name": "LS_SFTPDestinationSSHKey",
	"properties": {
		"parameters": {
			"DestinationIPAddress": {
				"type": "string"
			},
			"DestinationPortNumber": {
				"type": "int"
			},
			"DestinationUserName": {
				"type": "string"
			},
			"DestinationFolder": {
				"type": "string"
			},
			"DestinationSSHKey": {
				"type": "string"
			},
			"DestinationPassPhrase": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Sftp",
		"typeProperties": {
			"host": "@{linkedService().DestinationIPAddress}",
			"port": "@linkedService().DestinationPortNumber",
			"skipHostKeyValidation": true,
			"authenticationType": "SshPublicKey",
			"userName": "@{linkedService().DestinationUserName}",
			"privateKeyContent": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "LS_KeyVault",
					"type": "LinkedServiceReference"
				},
				"secretName": {
					"value": "@linkedService().DestinationSSHKey",
					"type": "Expression"
				}
			},
			"passPhrase": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "LS_KeyVault",
					"type": "LinkedServiceReference"
				},
				"secretName": {
					"value": "@linkedService().DestinationPassPhrase",
					"type": "Expression"
				}
			}
		}
	},
	"type": "Microsoft.DataFactory/factories/linkedservices"
}