{
	"name": "LS_AzureDataLakeStorage_ServicePrincipalAuth",
	"type": "Microsoft.DataFactory/factories/linkedservices",
	"properties": {
		"parameters": {
			"ServiceEndPoint": {
				"type": "string"
			},
			"TenantID": {
				"type": "string"
			},
			"ServicePrincipalID": {
				"type": "string"
			},
			"ServicePrincipalKey": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "AzureBlobFS",
		"typeProperties": {
			"url": "@{linkedService().ServiceEndPoint}",
			"tenant": "@{linkedService().TenantID}",
			"servicePrincipalId": "@{linkedService().ServicePrincipalID}",
			"servicePrincipalCredentialType": "ServicePrincipalKey",
			"servicePrincipalCredential": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "LS_KeyVault",
					"type": "LinkedServiceReference"
				},
				"secretName": {
					"value": "@linkedService().ServicePrincipalKey",
					"type": "Expression"
				}
			}
		}
	}
}