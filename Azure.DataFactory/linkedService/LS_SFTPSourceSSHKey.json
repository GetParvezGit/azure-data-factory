{
	"name": "LS_SFTPSourceSSHKey",
	"properties": {
		"parameters": {
			"SourceIPAddress": {
				"type": "string"
			},
			"SourcePortNumber": {
				"type": "int"
			},
			"SourceUserName": {
				"type": "string"
			},
			"SourceSSHKey": {
				"type": "string"
			},
			"SourcePassPhrase": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Sftp",
		"typeProperties": {
			"host": "@{linkedService().SourceIPAddress}",
			"port": "@linkedService().SourcePortNumber",
			"skipHostKeyValidation": true,
			"authenticationType": "SshPublicKey",
			"userName": "@{linkedService().SourceUserName}",
			"privateKeyContent": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "LS_KeyVault",
					"type": "LinkedServiceReference"
				},
				"secretName": {
					"value": "@linkedService().SourceSSHKey",
					"type": "Expression"
				}
			},
			"passPhrase": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "LS_KeyVault",
					"type": "LinkedServiceReference"
				},
				"secretName": {
					"value": "@linkedService().SourcePassPhrase",
					"type": "Expression"
				}
			}
		}
	},
	"type": "Microsoft.DataFactory/factories/linkedservices"
}